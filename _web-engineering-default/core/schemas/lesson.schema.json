{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LessonProposal",
  "type": "object",
  "required": ["id", "title", "status", "date", "project"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "status": { "enum": ["proposed", "accepted", "rejected"] },
    "rejectionReason": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "project": { "type": "string" },
    "problem": { "type": "string" },
    "investigation": { "type": "string" },
    "fix": { "type": "string" },
    "verification": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "generalizes": { "type": ["boolean", "null"] },
    "targetLayer": {
      "enum": ["core-rule", "profile-rule", "module-rule", "example", "anti-pattern", "detector", null]
    }
  }
}

<section id="our-club" class="section section-alt">
  <div class="section-inner">
    <h2>Our <span class="accent">Club</span></h2>
    <div class="section-divider section-divider--purple"></div>
    <p class="section-subtitle">
      2023 State Cup champions (2008 boys), 2022 State Cup champions (2009 girls),
      NorCal Premier podium finishes, and 27 first-place trophies club-wide —
      Morgan Hill, Gilroy, and Hollister.
    </p>
    <div class="gallery-grid">
      <img
        src="/images/team-girls-state-cup-champions.jpg"
        alt="2009 Sentinels girls — 2022 State Cup Champions at PayPal Park stadium"
        loading="lazy"
      />
      <img
        src="/images/team-girls-norcal-podium-trophy.jpg"
        alt="Sentinels girls team on the NorCal Premier winners podium with the championship trophy"
        loading="lazy"
      />
      <img
        src="/images/team-boys-three-trophies.jpg"
        alt="Sentinels boys team posing with three championship trophies on the field"
        loading="lazy"
      />
      <img
        src="/images/players-stadium-walkout-duo.jpg"
        alt="Two Sentinels players walking out onto the stadium pitch"
        loading="lazy"
      />
      <img
        src="/images/players-face-paint-duo.jpg"
        alt="Two Sentinels teammates in blue face paint on a club match day"
        loading="lazy"
      />
      <img
        src="/images/coaches-with-players-candid.jpg"
        alt="Sentinels coaches carrying young players outdoors in a candid Morgan Hill moment"
        loading="lazy"
      />
    </div>
    <p
      style="text-align: center; margin-top: 28px; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px"
    >
      <a href="/gallery" class="btn-primary">See the Full Gallery →</a>
      <a href="/about" class="btn-primary">About Us →</a>
    </p>
  </div>
</section>

---
import { CONTACT } from "../consts";
---

<section id="programs" class="section">
  <div class="section-inner">
    <h2>Our <span class="accent">Programs</span></h2>
    <div class="section-divider"></div>
    <p class="section-subtitle">
      Competitive teams, recreational leagues, private training, and summer camps
      for boys and girls ages 5 to 18.
    </p>
    <div class="about-programs-grid">
      <div class="about-program-card card-accent-green is-featured">
        <h3>Recreational Soccer</h3>
        <p>
          <strong>Fall 2026 registration is open</strong> — the season starts in
          August. A 10-week season with two practices per week and weekend games.
          Players learn the fundamentals in a positive setting.
        </p>
        <a
          href={CONTACT.registrationUrl}
          class="btn-primary"
          style="font-size: 0.78rem; padding: 8px 16px">Sign Up →</a
        >
        <a
          href="/recreational"
          style="display:block; margin-top:10px; font-size:0.8rem; font-weight:600"
          >Program details →</a
        >
      </div>
      <div class="about-program-card card-accent-purple">
        <h3>Competitive Soccer</h3>
        <p>
          Year-round training for ages 5 to 18. Structured practices, league play,
          and tournaments. Players develop technical, tactical, and mental skills
          at a high level.
        </p>
        <a
          href="/competitive"
          class="btn-primary"
          style="font-size: 0.78rem; padding: 8px 16px">View Program →</a
        >
      </div>
      <div class="about-program-card card-accent-blue">
        <h3>Private Training</h3>
        <p>
          One-on-one and small-group sessions built around your player's goals.
          Focused work on finishing, first touch, and decision making with a
          Sentinels coach.
        </p>
        <a
          href="/private-training"
          class="btn-primary"
          style="font-size: 0.78rem; padding: 8px 16px">View Program →</a
        >
      </div>
      <div class="about-program-card card-accent-gold">
        <h3>Summer Camps</h3>
        <p>
          Week-long day camps for ages 5 to 12. Station work, dribbling drills,
          scrimmages, and goal-scoring challenges. Players build skills and stay
          active between seasons.
        </p>
        <a
          href="/summer-camps"
          class="btn-primary"
          style="font-size: 0.78rem; padding: 8px 16px">View Program →</a
        >
      </div>
    </div>
  </div>
</section>

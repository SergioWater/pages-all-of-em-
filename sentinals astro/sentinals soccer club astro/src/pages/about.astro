---
import BaseLayout from "../layouts/BaseLayout.astro";

---

<BaseLayout title="About Us" description="Sentinels Soccer Club has developed youth players in Morgan Hill, Gilroy, and Hollister since 2015 through competitive teams, rec leagues, and summer camps.">
<h1 class="vh">About Sentinels Soccer Club</h1>

<section id="about-us" class="section section-alt">
        <div class="section-inner">
            <h2><span class="accent">About</span> Us</h2>
            <div class="section-divider"></div>

            <!-- <div class="needs-content-banner">
        <div class="icon">ðŸš§</div>
        <div>
          <div class="text">THIS PAGE NEEDS CONTENT</div>
          <div class="subtext">The About Us page on the live site is currently blank. Below is the approved copy ready
            for implementation.</div>
        </div>
      </div> -->

            <p class="section-subtitle">
                A Morgan Hill, Gilroy, and Hollister club built on hard work,
                respect, and players who keep getting better.
            </p>

            <div class="about-content">
                <!-- Intro: Who We Are + Mission -->
                <div class="about-intro">
                    <div>
                        <h2>Who We Are</h2>
                        <p>
                            Sentinels Soccer Club has trained youth players
                            in Morgan Hill, Gilroy, Hollister, and the
                            surrounding South County since 2015. We run
                            competitive teams, recreational leagues, and
                            summer camps for boys and girls ages 5 to 18.
                        </p>
                        <p>
                            Your kid shows up. Our coaches get to work.
                            They leave a better player and a better
                            teammate.
                        </p>
                    </div>
                    <div class="about-mission">
                        <h3>
                            <i class="fas fa-bullseye"></i> Our Mission
                        </h3>
                        <img src="/images/team-young-boys-cup.jpg" alt="Sentinels young boys team holding championship cup at goal" class="about-mission-photo" />
                        <p>
                            We develop young athletes through structured
                            training, competitive play, and a club culture
                            built on respect and hard work. Soccer teaches
                            confidence, discipline, and how to rely on
                            other people. Our coaches reinforce those
                            lessons at practice, on game day, and between
                            seasons.
                        </p>
                    </div>
                </div>

                <!-- Photo strip -->
                <section class="about-photo-strip">
                    <img src="/images/coaches-with-players-candid.jpg" alt="Sentinels Soccer Club coaches with young players in Morgan Hill" loading="lazy" />
                    <img src="/images/team-boys-three-trophies.jpg" alt="Sentinels youth boys soccer team celebrating with three championship trophies" loading="lazy" />
                    <img src="/images/team-teen-girls-celebration.jpg" alt="Sentinels teen girls soccer team celebrating a tournament win" loading="lazy" />
                </section>

                <!-- What Sets Us Apart -->
                <h2>What Sets Us Apart</h2>
                <div class="section-divider"></div>
                <div class="apart-grid">
                    <div class="apart-card">
                        <div class="apart-icon">
                            <i class="fas fa-user-check"></i>
                        </div>
                        <h3>A Spot for Every Player</h3>
                        <p>
                            Five-year-olds trying soccer for the first
                            time train alongside teenagers chasing college
                            rosters. We match players to the right program
                            and the right level of competition.
                        </p>
                    </div>
                    <div class="apart-card">
                        <div class="apart-icon">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <h3>Year-Round Training</h3>
                        <p>
                            Our competitive program runs all year with
                            short breaks at the holidays and after school
                            ends. Recreational and summer camp programs
                            fill the gaps. Your player stays sharp in
                            every season.
                        </p>
                    </div>
                    <div class="apart-card">
                        <div class="apart-icon">
                            <i class="fas fa-chalkboard-user"></i>
                        </div>
                        <h3>Coaches Who Build Complete Players</h3>
                        <p>
                            Our staff teaches dribbling, passing, shooting,
                            and positioning. They also teach fitness,
                            mental toughness, and game awareness.
                            Technical skill without tactical thinking wins
                            nothing.
                        </p>
                    </div>
                    <div class="apart-card">
                        <div class="apart-icon">
                            <i class="fas fa-people-group"></i>
                        </div>
                        <h3>Families Across Three Cities</h3>
                        <p>
                            Sentinels families come from Morgan Hill,
                            Gilroy, Hollister, and the surrounding towns.
                            You will see the same parents on the sidelines
                            week after week. That is how a club becomes a
                            community.
                        </p>
                    </div>
                </div>

                <!-- Banner -->
                <div class="about-banner" style="background-image: url('/images/team-teen-boys-best-of-the-best.jpg');">
                    <div class="about-banner-overlay"></div>
                </div>

                <!-- Values -->
                <h2>Our Values</h2>
                <div class="section-divider"></div>
                <div class="values-grid">
                    <div class="value-card">
                        <h3>Compete Beyond the Field</h3>
                        <p>
                            Character, resilience, and sportsmanship carry
                            into school, work, and life.
                        </p>
                    </div>
                    <div class="value-card">
                        <h3>Embrace Diversity</h3>
                        <p>
                            We welcome players and families of all
                            backgrounds.
                        </p>
                    </div>
                    <div class="value-card">
                        <h3>Grow From Feedback</h3>
                        <p>
                            Players learn to listen, adapt, and improve.
                        </p>
                    </div>
                    <div class="value-card">
                        <h3>Fuel Your Ambition</h3>
                        <p>
                            Set goals. Put in the work. Hit them.
                        </p>
                    </div>
                    <div class="value-card">
                        <h3>Live a Healthy Lifestyle</h3>
                        <p>
                            Physical fitness and positive habits start on
                            the pitch.
                        </p>
                    </div>
                </div>

                <h2>Our Programs</h2>
                <div class="section-divider"></div>
                <div class="about-programs-grid">
                    <div class="about-program-card card-accent-purple">
                        <h3>Competitive Soccer</h3>
                        <p>
                            Year-round training for ages 5 to 18. Structured
                            practices, league play, and tournaments. Players
                            develop technical, tactical, and mental skills
                            at a high level.
                        </p>
                        <a href="/competitive" class="btn-primary" style="font-size: 0.78rem; padding: 8px 16px">View
                            Program â†’</a>
                    </div>
                    <div class="about-program-card card-accent-green">
                        <h3>Recreational Soccer</h3>
                        <p>
                            A 10-week season (Fall and Spring) with two
                            practices per week and weekend games. Players
                            learn the fundamentals in a positive setting.
                            Nike uniform kit included.
                        </p>
                        <a href="/recreational" class="btn-primary" style="font-size: 0.78rem; padding: 8px 16px">View
                            Program â†’</a>
                    </div>
                    <div class="about-program-card card-accent-gold">
                        <h3>Summer Camps</h3>
                        <p>
                            Week-long day camps for ages 5 to 12. Station
                            work, dribbling drills, scrimmages, and
                            goal-scoring challenges. Players build skills
                            and stay active between seasons.
                        </p>
                        <a href="/summer-camps" class="btn-primary" style="font-size: 0.78rem; padding: 8px 16px">View
                            Program â†’</a>
                    </div>
                </div>

                <!-- Serving the South County Community -->
                <div class="about-community">
                    <div class="about-community-text">
                        <h2>Serving the South County Community</h2>
                        <div class="section-divider"></div>
                        <p>
                            Sentinels started in Morgan Hill in 2015 and has
                            grown to serve families across Gilroy and
                            Hollister. Whatever program your child joins â€”
                            competitive, recreational, private training, or
                            summer camps â€” they'll train with coaches who
                            understand what South County youth soccer looks
                            like and what it takes to develop players who can
                            compete at the next level.
                        </p>
                    </div>
                    <img src="/images/team-2014-half-moon-bay-champions.jpg" alt="2014 birth-year Sentinels boys team Half Moon Bay champions with medals" class="about-community-photo" loading="lazy" />
                </div>

                <div class="about-cta">
                    <h2>Join the Sentinels</h2>
                    <p>
                        We have a spot for your player. Pick the program
                        that fits and sign up.
                    </p>
                    <p>
                        <a href="/tryouts"><strong>Register for Tryouts</strong></a>
                        &nbsp;|&nbsp;
                        <a href="/recreational"><strong>Browse Programs</strong></a>
                    </p>
                    <p style="margin-bottom: 0">
                        Questions? Email us at
                        <a
                            href="mailto:sentinelssoccerclub@gmail.com"><strong>sentinelssoccerclub@gmail.com</strong></a>
                        or call <strong>(408) 722-1028</strong>.
                    </p>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
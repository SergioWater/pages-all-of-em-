---
import BaseLayout from "../layouts/BaseLayout.astro";

---

<BaseLayout title="Competitive Soccer" description="Year-round competitive soccer for ages 5-18 in Morgan Hill, Gilroy, and Hollister. NorCal Premier leagues, tournaments, and structured training.">
<h1 class="vh">Sentinels Soccer Club Competitive Soccer Program</h1>

<section id="competitive" class="section">
        <div class="section-inner">
            <h2><span class="accent">Competitive</span> Program</h2>
            <div class="section-divider"></div>
            <p class="section-subtitle">
                Year-round training for boys and girls, ages 5 to 18.
                Structured practices, league play, and tournaments.
            </p>

            <p>
                Our competitive program builds complete players. Athletes
                develop technical, tactical, physical, and mental skills
                through structured training and high-level match play. Teams
                compete in NorCal Premier Soccer leagues and select
                tournaments throughout the year.
            </p>

            <a href="https://norcalpremier.com/club/13079/" target="_blank" rel="noopener noreferrer"
                class="btn-primary">
                <i class="fas fa-shield-halved"></i> View Our NorCal Premier
                Club Page
                <i class="fas fa-arrow-up-right-from-square" style="font-size: 0.75em; margin-left: 4px"></i>
            </a>

            <h3>Skills We Develop</h3>
            <div class="skills-grid">
                <div class="skill-card">
                    <i class="fas fa-futbol" style="color: var(--green); margin-right: 6px"></i>
                    Dribbling
                </div>
                <div class="skill-card">
                    <i class="fas fa-arrows-alt" style="color: var(--green); margin-right: 6px"></i>
                    Passing
                </div>
                <div class="skill-card">
                    <i class="fas fa-bullseye" style="color: var(--green); margin-right: 6px"></i>
                    Shooting
                </div>
                <div class="skill-card">
                    <i class="fas fa-hand-paper" style="color: var(--green); margin-right: 6px"></i>
                    Control
                </div>
                <div class="skill-card">
                    <i class="fas fa-brain" style="color: var(--green); margin-right: 6px"></i>
                    Heading
                </div>
                <div class="skill-card">
                    <i class="fas fa-hands" style="color: var(--green); margin-right: 6px"></i>
                    Goalkeeping
                </div>
                <div class="skill-card">
                    <i class="fas fa-shield-alt" style="color: var(--green); margin-right: 6px"></i>
                    Defending
                </div>
                <div class="skill-card">
                    <i class="fas fa-chess" style="color: var(--green); margin-right: 6px"></i>
                    Game Awareness
                </div>
                <div class="skill-card">
                    <i class="fas fa-users" style="color: var(--green); margin-right: 6px"></i>
                    Teamwork
                </div>
                <div class="skill-card">
                    <i class="fas fa-heartbeat" style="color: var(--green); margin-right: 6px"></i>
                    Fitness
                </div>
            </div>

            <div class="comp-images">
                <img src="/images/stock-passing-drill-stadium.jpg" alt="Passing drills" loading="lazy" />
                <img src="/images/stock-shooting-on-goal.jpg" alt="Shooting practice" loading="lazy" />
                <img src="/images/training-cone-drill-three-players.jpg" alt="Sentinels players training" loading="lazy" />
            </div>

            <div class="comp-split">
                <div class="comp-card">
                    <h3><i class="fas fa-mars"></i> Boys' Competitive</h3>
                    <p>
                        Teams from U6 through U19. Year-round training with
                        fall and spring league seasons, plus tournament
                        opportunities. Players develop in a competitive
                        environment designed to challenge and improve every
                        aspect of their game.
                    </p>
                    <p>
                        Multiple training sessions per week with experienced
                        coaching staff. Age-appropriate development pathways
                        ensure players advance at the right pace.
                    </p>
                </div>
                <div class="comp-card">
                    <h3><i class="fas fa-venus"></i> Girls' Competitive</h3>
                    <p>
                        Full competitive pathway for female athletes, U6
                        through U19. Same high-quality coaching and training
                        structure as our boys' program. Girls compete in
                        NorCal Premier Soccer leagues and regional
                        tournaments.
                    </p>
                    <p>
                        We are committed to growing girls' soccer in South
                        County and providing every female player with a
                        pathway to excel.
                    </p>
                </div>
            </div>

            <!-- Proven Winners: boys + girls championship results -->
            <h3 style="margin-top: 40px">
                <i class="fas fa-trophy" style="color: var(--gold); margin-right: 6px"></i>
                Proven Winners
            </h3>
            <div class="section-divider section-divider--purple"></div>
            <p style="max-width: 760px">
                Our competitive teams don't just train â€” they win. Sentinels squads have earned
                <strong>State Cup titles</strong>, <strong>NorCal Premier podium finishes</strong>,
                <strong>Best of the Best honors</strong>, and futsal championships across both our
                boys' and girls' programs.
            </p>
            <div class="gallery-grid">
                <img src="/images/team-girls-state-cup-champions.jpg"
                    alt="Sentinels girls competitive team named State Cup Champions at PayPal Park stadium"
                    loading="lazy" />
                <img src="/images/team-teen-boys-best-of-the-best.jpg"
                    alt="Sentinels teen boys competitive team named Best of the Best with tournament medals"
                    loading="lazy" />
                <img src="/images/team-girls-norcal-podium-trophy.jpg"
                    alt="Sentinels girls competitive team on the NorCal Premier winners podium with the championship trophy"
                    loading="lazy" />
                <img src="/images/team-boys-three-trophies.jpg"
                    alt="Sentinels boys competitive team posing with three championship trophies on the field"
                    loading="lazy" />
                <img src="/images/team-girls-norcal-premier-podium.jpg"
                    alt="Sentinels girls competitive team lifting their trophy on the NorCal Premier Soccer championship stage"
                    loading="lazy" />
                <img src="/images/team-boys-futsal-champions.jpg"
                    alt="Sentinels boys competitive futsal champions with trophy, medals, and coach indoors"
                    loading="lazy" />
            </div>

            <div style="margin-top: 32px; padding: 24px; background: var(--gray-100); border-radius: 8px;">
                <h3 style="margin-top: 0">
                    <i class="fas fa-user-tie" style="color: var(--green)"></i>
                    Private Training Available
                </h3>
                <p>
                    Looking for one-on-one or small-group coaching outside team practice?
                    Our <strong>Private Training</strong> program offers personalized sessions with
                    Coach Rick, Coach Nolan, and Coach Alex â€” focused on individual skill development,
                    position-specific work, and game preparation.
                </p>
                <a href="/private-training" class="btn-primary">
                    <i class="fas fa-arrow-right"></i> Learn More About Private Training
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
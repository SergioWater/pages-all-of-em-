---
import BaseLayout from "../layouts/BaseLayout.astro";
import { faqPageSchema } from "../lib/schema";
import { FAQ_ITEMS } from "../lib/faq";

const schemas = [faqPageSchema(FAQ_ITEMS)];
---

<BaseLayout
  title="FAQ"
  description="Answers about Sentinels Soccer Club programs, ages, seasons, equipment, tryouts, summer camp cost, and registration in Morgan Hill, Gilroy, and Hollister, CA."
  schemas={schemas}
>
  <h1 class="vh">Sentinels Soccer Club — Frequently Asked Questions</h1>

  <section id="faq" class="section">
    <div class="section-inner">
      <h2>Frequently Asked <span class="accent">Questions</span></h2>
      <div class="section-divider"></div>
      <p class="section-subtitle">
        Answers to the questions Morgan Hill, Gilroy, and Hollister families ask
        most.
      </p>
      <div class="rec-layout" style="display:block">
        <div>
          {
            FAQ_ITEMS.map((item) => (
              <div class="faq-item">
                <strong>{item.question}</strong>
                {item.answer}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
---
import BaseLayout from "../layouts/BaseLayout.astro";

---

<BaseLayout title="Contact" description="Get in touch with Sentinels Soccer Club. Email sentinelssoccerclub@gmail.com or call (408) 722-1028. Serving Morgan Hill, Gilroy, and Hollister, CA.">
<h1 class="vh">Contact Sentinels Soccer Club</h1>

<section id="contact" class="section">
        <div class="section-inner">
            <h2>Get in <span class="accent">Touch</span></h2>
            <div class="section-divider"></div>
            <p class="section-subtitle">
                A quick note is all it takes â€” reach out and we'll get back
                to you.
            </p>

            <div class="contact-email-wrap">
                <a href="mailto:sentinelssoccerclub@gmail.com" class="contact-email-btn"
                    aria-label="Email Sentinels Soccer Club">
                    <i class="fas fa-envelope"></i>
                </a>
                <a href="tel:4087221028" class="contact-phone-btn" aria-label="Call Sentinels Soccer Club">
                    <i class="fas fa-phone-volume"></i>
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
<BaseLayout title="Summer Camps" description="Summer soccer day camps in Morgan Hill for ages 5-12. Week-long camps with drills, scrimmages, and Sentinels coaching staff. $150/week.">
<h1 class="vh">Sentinels Soccer Club Summer Soccer Camps â€” Morgan Hill, CA</h1>

<section id="summer-camps" class="section">
        <div class="section-inner">
            <h2>Summer <span class="accent">Camps</span></h2>
            <div class="section-divider"></div>
            <p class="section-subtitle">
                Week-long day camps to keep your player active and improving
                all summer.
            </p>

            <div class="camp-detail-grid">
                <div class="camp-detail-card">
                    <div class="label">Ages</div>
                    <div class="value">5 â€“ 12</div>
                </div>
                <div class="camp-detail-card">
                    <div class="label">Time</div>
                    <div class="value">9 AM â€“ 12 PM</div>
                </div>
                <div class="camp-detail-card">
                    <div class="label">Cost</div>
                    <div class="value">$150 / week</div>
                </div>
            </div>

            <p>
                Our summer camps give young players a fun, structured soccer
